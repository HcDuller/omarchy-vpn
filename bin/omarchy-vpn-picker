#!/bin/bash
# Manages flea, the file picker this plugin depends on. flea provides the
# xdg-desktop-portal FileChooser backend, and omarchy-vpn-pick-file's
# Gtk.FileChooserNative goes through that portal, so with flea configured the
# user sees flea's dialog. Only the picker backend is claimed -- the default
# file manager is never touched (no `flea --default`).
#
#   status  prints one of: ready | portal-pending | installing | absent
#   use     makes flea the portal FileChooser (idempotent), prints "ready"
#   mark-installing   records that an install terminal was launched
#
# FLEA_VPN_TEST_ABSENT=1 makes `status` behave as if flea were not installed
# (test hook for exercising the install path on a machine that has flea).
set -uo pipefail

state_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-vpn"
mkdir -p "$state_dir"
installing="$state_dir/flea-installing"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal/portals.conf"

has_flea() {
  [ "${FLEA_VPN_TEST_ABSENT:-}" = "1" ] && return 1
  command -v flea >/dev/null 2>&1
}

portal_configured() {
  [ -f "$conf" ] && grep -Eq '^org\.freedesktop\.impl\.portal\.FileChooser=.*\bflea\b' "$conf"
}

# An install marker only counts for a few minutes: the terminal may have been
# closed without installing, and that must not block a retry forever.
install_in_progress() {
  [ -f "$installing" ] || return 1
  local now mtime
  now=$(date +%s)
  mtime=$(stat -c %Y "$installing" 2>/dev/null || echo 0)
  [ $(( now - mtime )) -lt 240 ]
}

case "${1:-status}" in
  status)
    if has_flea; then
      rm -f "$installing"
      if portal_configured; then echo ready; else echo portal-pending; fi
    elif install_in_progress; then
      echo installing
    else
      echo absent
    fi
    ;;
  use)
    has_flea || { echo "flea is not installed" >&2; exit 1; }
    if ! portal_configured; then
      flea --picker >/dev/null 2>&1
      systemctl --user restart xdg-desktop-portal >/dev/null 2>&1
    fi
    portal_configured && echo ready || { echo "could not configure flea as the portal file chooser" >&2; exit 1; }
    ;;
  mark-installing)
    # Atomic claim so only one per-monitor plugin instance launches the
    # installer terminal: succeeds (exit 0) for the first caller, 1 for the rest.
    exec 9>"$installing.lock"
    flock -n 9 || exit 1
    if install_in_progress; then exit 1; fi
    touch "$installing"
    ;;
  *)
    echo "usage: omarchy-vpn-picker status|use|mark-installing" >&2
    exit 2
    ;;
esac
