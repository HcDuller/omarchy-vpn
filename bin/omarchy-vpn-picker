#!/bin/bash
# Manages the flea file picker as an OPTIONAL dependency.
#
# flea's picker dialog is invoked by omarchy-vpn-pick-file --flea, which calls
# flea's portal backend D-Bus service directly. Nothing here ever touches
# portals.conf or claims the FileChooser portal globally -- the plugin never
# changes which file picker other applications use.
#
#   status           one of: ready | declined | installing | absent
#   decline          persist the "use the system file picker" choice
#   choose-flea      remove the persisted choice (back to flea when present)
#   mark-installing  atomically record that an install terminal was launched
#
# The choice marker lives in the user's state directory and survives reboots;
# deleting it makes the plugin ask again on the next pick attempt.
#
# FLEA_VPN_TEST_ABSENT=1 makes `status` behave as if flea were not installed
# (test hook for exercising the prompt/install path on a machine that has it).
set -uo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-vpn"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-vpn"
installing="$runtime_dir/flea-installing"
choice="$state_dir/picker-choice"
mkdir -p "$runtime_dir" "$state_dir"

has_flea() {
  [ "${FLEA_VPN_TEST_ABSENT:-}" = "1" ] && return 1
  command -v flea >/dev/null 2>&1
}

# An install marker only counts for a few minutes: the terminal may have been
# closed without installing, and that must not block a retry forever.
install_in_progress() {
  [ -f "$installing" ] || return 1
  local now mtime
  now=$(date +%s)
  mtime=$(stat -c %Y "$installing" 2>/dev/null || echo 0)
  [ $(( now - mtime )) -lt 240 ]
}

case "${1:-status}" in
  status)
    if [ -f "$choice" ]; then
      echo declined
    elif has_flea; then
      rm -f "$installing"
      echo ready
    elif install_in_progress; then
      echo installing
    else
      echo absent
    fi
    ;;
  decline)
    printf 'declined\n' > "$choice"
    ;;
  choose-flea)
    rm -f "$choice"
    ;;
  mark-installing)
    # Atomic claim so only one per-monitor plugin instance launches the
    # installer terminal: succeeds (exit 0) for the first caller, 1 for the rest.
    exec 9>"$installing.lock"
    flock -n 9 || exit 1
    if install_in_progress; then exit 1; fi
    touch "$installing"
    ;;
  *)
    echo "usage: omarchy-vpn-picker status|decline|choose-flea|mark-installing" >&2
    exit 2
    ;;
esac
