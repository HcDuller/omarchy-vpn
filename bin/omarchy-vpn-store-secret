#!/bin/bash
# Stores a password on an existing profile (vpn.secrets + password-flags=1),
# leaving the rest of vpn.data alone. Password arrives as one JSON line on
# stdin so it never appears in argv.
set -uo pipefail

uuid="${1:?usage: omarchy-vpn-store-secret <uuid>}"
IFS= read -r line
password=$(printf '%s' "$line" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("password",""), end="")')

nmcli connection modify "$uuid" +vpn.data "password-flags = 1" || exit 1
printf 'set vpn.secrets password=%s\nsave\nquit\n' "$password" | nmcli connection edit uuid "$uuid" >/dev/null
