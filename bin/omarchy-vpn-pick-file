#!/usr/bin/python3
"""Picks a single file. Two backends, chosen by argv[1]:

  flea     talks to flea's portal FileChooser backend (impl D-Bus interface)
           directly -- flea's picker window opens, but no portals.conf claim is
           made, so other applications keep the desktop's configured chooser.
  system   in-process GTK FileChooserNative (the standard GTK file dialog),
           independent of portal configuration entirely.

Prints the chosen path to stdout, exits 0 -- or exits 1 with nothing on stdout
if the dialog was cancelled.
"""
import os
import sys

# System mode must not route through the portal: FileChooserNative uses
# xdg-desktop-portal whenever it is told to (or when sandboxed). Unset it so a
# declined flea yields the plain in-process GTK dialog, immune to whatever
# claims exist in portals.conf on this machine.
os.environ.pop("GTK_USE_PORTAL", None)

BUS_NAME = "org.freedesktop.impl.portal.desktop.flea"
OBJ_PATH = "/org/freedesktop/portal/desktop"
IFACE = "org.freedesktop.impl.portal.FileChooser"
DIALOG_TITLE = "Choose a file"

FLEA_FILTERS = [("OpenVPN config (*.ovpn, *.conf)", [(0, "*.ovpn"), (0, "*.conf")])]


def pick_flea():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    state = {"code": None, "path": None, "finished": False}

    def on_reply(_source, res, _ud):
        if state["finished"]:
            return
        state["finished"] = True
        try:
            unpacked = conn.call_finish(res).unpack()
        except GLib.Error as e:
            # flea-portal quits when left idle, dropping the pending call:
            # that is a cancel, not an error worth showing.
            if "Disconnected" not in str(e) and "NoReply" not in str(e) and "ServiceUnknown" not in str(e):
                print("pick failed: %s" % e, file=sys.stderr)
            loop.quit()
            return
        state["code"] = unpacked[0]
        if unpacked[0] == 0 and len(unpacked) > 1:
            uris = unpacked[1].get("uris", [])
            if uris:
                # The portal returns file:// URIs; callers want a plain path.
                from urllib.parse import unquote, urlparse
                parsed = urlparse(uris[0])
                state["path"] = unquote(parsed.path) if parsed.scheme == "file" else uris[0]
        loop.quit()

    conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    token = "omarchyvpnpick%d" % int(GLib.get_monotonic_time() % 1000000)
    req_path = "/org/freedesktop/portal/desktop/request/%s/%s" % (
        conn.get_unique_name()[1:].replace(".", "_"), token)

    opts = GLib.Variant("a{sv}", {
        "handle_token": GLib.Variant("s", token),
        "filters": GLib.Variant("a(sa(us))", FLEA_FILTERS),
        "modal": GLib.Variant("b", True),
    })
    params = GLib.Variant.new_tuple(
        GLib.Variant("o", req_path),
        GLib.Variant("s", "omarchy-vpn"),
        GLib.Variant("s", ""),
        GLib.Variant("s", DIALOG_TITLE),
        opts)

    conn.call(BUS_NAME, OBJ_PATH, IFACE, "OpenFile", params, None,
              Gio.DBusCallFlags.NONE, 300000, None, on_reply, None)

    loop = GLib.MainLoop()
    GLib.timeout_add_seconds(90, loop.quit)
    loop.run()

    if state["path"]:
        print(state["path"])
        return 0
    # A cancel (response 1) or timeout is silent; only genuine backend
    # failures (response 2 / unexpected) write to stderr.
    if state["code"] not in (None, 1):
        sys.stderr.write("file picker failed (code=%s)\n" % state["code"])
    return 1


def pick_system():
    # GTK prints harmless CRITICAL/WARNING lines on stderr (e.g. when the
    # dialog is dismissed); the panel shows stderr as an error message, so
    # keep a plain cancel silent.
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, 2)

    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk

    dialog = Gtk.FileChooserNative.new(
        DIALOG_TITLE, None, Gtk.FileChooserAction.OPEN, "_Open", "_Cancel")

    ovpn_filter = Gtk.FileFilter()
    ovpn_filter.set_name("OpenVPN config (*.ovpn, *.conf)")
    ovpn_filter.add_pattern("*.ovpn")
    ovpn_filter.add_pattern("*.conf")
    dialog.add_filter(ovpn_filter)

    all_filter = Gtk.FileFilter()
    all_filter.set_name("All files")
    all_filter.add_pattern("*")
    dialog.add_filter(all_filter)

    response = dialog.run()
    path = dialog.get_filename()
    dialog.destroy()

    if response != Gtk.ResponseType.ACCEPT or not path:
        return 1
    print(path)
    return 0


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "system"
    sys.exit(pick_flea() if mode == "flea" else pick_system())
